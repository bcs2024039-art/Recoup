{
  "version": 2,
  "buildCommand": "npm run build --workspace=frontend",
  "outputDirectory": "frontend/dist",
  "rewrites": [
    {
      "source": "/api/gemini",
      "destination": "/api/gemini"
    },
    {
      "source": "/api/batch",
      "destination": "/api/batch"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
