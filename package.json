{
  "name": "recoup",
  "version": "1.0.0",
  "private": true,
  "workspaces": ["frontend"],
  "scripts": {
    "dev:frontend": "npm run dev --workspace=frontend",
    "dev:python": "cd backend && python3 api.py",
    "dev": "concurrently \"npm run dev:frontend\" \"npm run dev:python\"",
    "build": "npm run build --workspace=frontend",
    "lint": "npm run lint --workspace=frontend",
    "start:frontend": "npm run start --workspace=frontend",
    "start:python": "cd backend && python3 api.py",
    "start": "concurrently \"npm run start:frontend\" \"npm run start:python\""
  },
  "dependencies": {
    "@google/genai": "^2.21.0",
    "firebase": "^12.19.0"
  }
}
