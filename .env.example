# ── Required ───────────────────────────────────────────────────────────────
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ── Optional ───────────────────────────────────────────────────────────────
# Port the Node/Express server listens on (default: 3000)
PORT=3000

# Internal URL of the Python FastAPI service.
# Set automatically by docker-compose to http://api:8000.
# For manual local dev: set to http://localhost:8000 if running Python separately.
# Leave unset to run in browser-only mode (Python engine toggle hidden).
PYTHON_API_URL=http://localhost:8000
